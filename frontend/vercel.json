{
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://bjp-backend.onrender.com/api/:path*"
    },
    {
      "source": "/admin/api/:path*",
      "destination": "https://bjp-backend.onrender.com/admin/api/:path*"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
